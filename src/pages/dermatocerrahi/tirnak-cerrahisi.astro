---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro';
import FaqSchema from '../../components/FaqSchema.astro';

const title = "Tırnak Cerrahisi - Uzm. Dr. Umut Mert Yıldırım";
const description = "Tırnak batması, tırnak çıkıntısı ve diğer tırnak sorunlarının cerrahi tedavisi. Tırnak cerrahisi işlemi nasıl yapılır? İşlem süreci ve sonrası bakım hakkında detaylı bilgi.";

// SSS için soru-cevaplar
const faqQuestions = [
  {
    question: "Tırnak cerrahisi nedir ve nasıl çalışır?",
    answer: "Tırnak cerrahisi, tırnak batması, tırnak çıkıntısı ve diğer medikal olarak tedavi edilemeyen tırnak sorunlarının cerrahi olarak tedavi edilmesini sağlayan minimal invaziv bir işlemdir. Özellikle tekrarlayan tırnak batması sorunu çeken bireylerde kalıcı çözüm sunar. İşlem lokal anestezi altında gerçekleştirilir ve tırnağın problem yaratan kısmının çıkarılması veya tamamının kaldırılması şeklinde uygulanabilir. Bu müdahale ile ağrıdan kurtulunur ve normal günlük yaşantıya dönülür."
  },
  {
    question: "Tırnak cerrahisi kimler için uygundur?",
    answer: "Tırnak cerrahisi, tırnak batması (onikokriptozis), tırnak çıkıntısı (hipertrofik tırnak kenarı) ve diğer tırnak anomalilerinin tedavisi amacıyla uygulanan cerrahi bir işlemdir. Tekrarlayan tırnak batması, ayak parmaklarında şiddetli ağrı, şişlik, kızarıklık ve enfeksiyonlara neden olabilir. Konservatif tedavilerin yetersiz kaldığı durumlarda tırnak cerrahisi kalıcı çözüm sunar. 18 yaşını tamamlamış, genel sağlık durumu iyi olan ve tırnak sorunları ile uğraşan her yetişkin birey için uygundur."
  },
  {
    question: "Tırnak cerrahisi ağrılı bir işlem midir?",
    answer: "İşlem lokal anestezi altında yapıldığı için hastalar işlem sırasında herhangi bir ağrı hissetmezler. Anestezi enjeksiyonu sırasında hafif bir battı hissi olabilir. İşlem sonrası ilk birkaç saat hafif ağrı olabilir. Ancak bu ağrı genellikle basit ağrı kesicilerle kontrol edilebilir. Çoğu hasta bu hissi kolayca tolere edebilir."
  },
  {
    question: "Tırnak cerrahisi etkisi ne zaman görülür?",
    answer: "Tırnak cerrahisi etkisi genellikle işlem sonrası hemen görülür. Tırnak batması nedeniyle oluşan ağrı ve rahatsızlık hemen azalır. Ancak maksimum etki 1-2 hafta içinde ortaya çıkar. Tırnak yatağı iyileşme süreci devam ettiği için etki 3-4 hafta boyunca gelişmeye devam eder. Düzenli uygulamalar ile etki daha kalıcı olur."
  },
  {
    question: "Tırnak cerrahisi kalıcı mıdır?",
    answer: "Evet, tırnak cerrahisi özellikle fenol uygulaması ile yapılan işlemlerde kalıcı çözüm sunar. Problem yaratan tırnak kenarının çıkarılması ve tırnak yatağına kimyasal madde uygulanması ile o bölgenin yeniden tırnak üretmemesi sağlanır. Ancak doğru bakım ve yaşam tarzı benimsenmelidir."
  }
];
---

<BaseLayout title={title} description={description}>
  
    <BreadcrumbSchema 
    links={[
      { name: "Ana Sayfa", url: "/" },
      { name: "Dermatocerrahi", url: "/dermatocerrahi/" },
      { name: "Tırnak Cerrahisi", url: "/dermatocerrahi/tirnak-cerrahisi/" },
    ]}
  />

   <FaqSchema questions={faqQuestions} />

  <main id="main-content" class="container mx-auto px-4 py-12">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold text-primary mb-8">
        Tırnak Cerrahisi
      </h1>
      
      <div class="prose prose-lg text-text-primary max-w-none">
        <p class="mb-8 leading-relaxed">
          Tırnak cerrahisi, tırnak batması, tırnak çıkıntısı 
          ve diğer medikal olarak tedavi edilemeyen tırnak sorunlarının cerrahi 
          olarak tedavi edilmesini sağlayan minimal 
          invaziv bir işlemdir. Özellikle tekrarlayan 
          tırnak batması sorunu çeken bireylerde 
          kalıcı çözüm sunar. İşlem lokal anestezi 
          altında gerçekleştirilir ve tırnağın 
          problem yaratan kısmının çıkarılması 
          veya tamamının kaldırılması 
          şeklinde uygulanabilir. 
          Bu müdahale ile 
          ağrıdan 
          kurtulunur 
          ve normal 
          günlük yaşantıya 
          dönülür.
        </p>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          Tırnak Cerrahisi Nedir ve Neden Yapılır?
        </h2>
        
        <p class="mb-6 leading-relaxed">
          Tırnak cerrahisi, tırnak batması (onikokriptozis), 
          tırnak çıkıntısı (hipertrofik tırnak kenarı) 
          ve diğer tırnak anomalilerinin tedavisi 
          amacıyla uygulanan cerrahi bir işlemdir. 
          Tekrarlayan tırnak batması, ayak parmaklarında 
          şiddetli ağrı, şişlik, kızarıklık ve 
          enfeksiyonlara neden olabilir. 
          Konservatif tedavilerin 
          yetersiz kaldığı 
          durumlarda tırnak 
          cerrahisi kalıcı 
          çözüm 
          sunar.
        </p>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          Tırnak Cerrahisi İşlemi Nasıl Yapılır?
        </h2>
        
        <p class="mb-6 leading-relaxed">
          Tırnak cerrahisi işlemi lokal anestezi 
          altında gerçekleştirilir. İlk olarak 
          ayak parmakları sterilize edilir ve 
          lokal anestezik enjekte edilir. 
          Problem yaratan tırnak kısmı 
          veya tamamı cerrahi olarak 
          çıkarılır. Tekrarlayan tırnak 
          batması durumunda tırnak 
          yatağına kimyasal madde 
          (fenol) uygulanarak o 
          bölgenin yeniden tırnak 
          üretmemesi sağlanır. 
          İşlem sonrası pansuman 
          yapılır ve hasta 
          yönlendirilir.
        </p>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          İşlem Sonrası Dikkat Edilmesi Gerekenler ve Bakım
        </h2>
        
        <div class="mb-6">
          <p class="leading-relaxed mb-4">
            Tırnak cerrahisi sonrası doğru bakım, 
            iyileşme sürecini hızlandırır ve 
            komplikasyon riskini azaltır:
          </p>
          <ul class="list-disc list-inside space-y-2">
            <li>İlk 24-48 saat içinde su değdirmeyin</li>
            <li>Doktorunuzun önerdiği şekilde düzenli pansuman değiştirin</li>
            <li>Dar ayakkabılardan kaçının</li>
            <li>Uygulama bölgesine baskı uygulamamaya çalışın</li>
            <li>Doktorunuzun önerdiği antibiyotik veya bakım ürünlerini kullanın</li>
            <li>Herhangi bir anormal durumda (aşırı kızarıklık, ağrı artışı, akıntı) doktorunuza başvurun</li>
            <li>Tam iyileşmeye kadar ağır spor ve fiziksel aktivitelerden kaçının</li>
            <li>Dikiş varsa doktorunuzun belirlediği tarihte dikişlerinizi aldırın</li>
          </ul>
        </div>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          Sıkça Sorulan Sorular
        </h2>
        
        <div class="space-y-6 mb-12">
          <div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">
              Tırnak batması cerrahisi kalıcı çözüm müdür?
            </h3>
            <p class="leading-relaxed">
              Batık tırnak cerrahisi, özellikle fenol 
              uygulaması ile yapılan işlemlerde 
              kalıcı çözüm sunar. Problem yaratan 
              tırnak kenarının çıkarılması ve 
              tırnak yatağına kimyasal 
              madde uygulanması ile 
              o bölgenin yeniden 
              tırnak üretmemesi 
              sağlanır.
            </p>
          </div>
          
          <div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">
              Tırnak cerrahisi ağrılı bir işlem midir?
            </h3>
            <p class="leading-relaxed">
              İşlem lokal anestezi altında yapıldığı 
              için hastalar işlem sırasında 
              herhangi bir ağrı hissetmezler. 
              Anestezi enjeksiyonu sırasında 
              hafif bir battı hissi 
              olabilir. İşlem sonrası 
              ilk birkaç saat 
              hafif ağrı 
              olabilir.
            </p>
          </div>
          
          <div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">
              İşlem ne kadar sürer?
            </h3>
            <p class="leading-relaxed">
              Tırnak cerrahisi işlemi genellikle 20-40 
              dakika sürer. Tırnak batmasının 
              şiddeti, etkilenen parmak 
              sayısı ve uygulanan 
              tekniklere göre işlem 
              süresi değişebilir. 
              İşlem sonrası 
              pansuman ve bakım 
              talimatları 
              verilir.
            </p>
          </div>
          
          <div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">
              Ne zaman günlük yaşama dönebilirim?
            </h3>
            <p class="leading-relaxed">
              Hastalar işlem sonrası hemen günlük 
              yaşamlarına dönebilirler. Ancak 
              işlem yapılan ayak parmaklarına 
              dikkat etmek ve önerilen 
              bakım talimatlarını 
              uygulamak gerekir. 
              İlk birkaç gün 
              hafif yürüyüşle 
              sınırlı 
              hareket 
              önerilir.
            </p>
          </div>
        </div>
      </div>
      
      <!-- Randevu Butonu -->
      <div class="text-center mt-12">
        <a 
          href="/iletisim" 
          class="inline-block bg-accent hover:bg-orange-600 text-white font-semibold py-4 px-8 rounded-lg transition-colors duration-300 transform hover:scale-105 shadow-lg"
        >
          📅 Randevu Al
        </a>
        <p class="mt-4 text-text-secondary">
          Uzman dermatolog gözetiminde tırnak cerrahisi için randevu alın.
        </p>
      </div>
    </div>
  </main>
  
</BaseLayout>