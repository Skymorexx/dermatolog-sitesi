---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../../components/BreadcrumbSchema.astro';
import FaqSchema from '../../../components/FaqSchema.astro';

const title = "Sciton BBL Hero Lazer Tedavileri - Uzm. Dr. Umut Mert Yıldırım";
const description = "Cilt yenileme ve anti-aging için uygulanan Sciton BBL Hero lazer tedavisi hakkında detaylı bilgi, uygulama süreci ve sıkça sorulan sorular.";

// SSS için soru-cevaplar
const faqQuestions = [
  {
    question: "Sciton BBL Hero lazer tedavisi nedir ve nasıl çalışır?",
    answer: "Sciton BBL Hero lazer tedavisi, cilt yüzeyindeki çeşitli estetik sorunların giderilmesi amacıyla uygulanan ileri teknoloji BroadBand Light (Geniş Bant Işık) sistemidir. Bu devrimsel lazer teknolojisi, ciltteki lekeleri, damarlanmaları, gözenek genişlemelerini ve ince çizgileri tedavi ederken aynı zamanda cilt yenilenmesini ve sıkılaşmasını sağlar. BBL Hero, farklı dalga boylarında çalışarak kişiselleştirilmiş tedavi planları oluşturur ve ciltte kapsamlı bir gençleşme etkisi sağlar. Bu işlem sayesinde cilt daha parlak, eşit tonlu ve genç bir görünüme kavuşur."
  },
  {
    question: "Sciton BBL Hero lazer tedavisi kimler için uygundur?",
    answer: "Sciton BBL Hero lazer tedavisi, farklı dalga boylarında çalışan BroadBand Light teknolojisinin cilt yüzeyine uygulanmasıyla gerçekleştirilen non-invaziv bir işlemdir. 18 yaşını geçmiş, genel sağlık durumu iyi olan ve cildinde yaşlanma belirtileri, lekeler, damarlanmalar veya genel cilt yorgunluğu görülen her yetişkin birey için uygundur. Özellikle güneş hasarı, cilt matlığı, renk eşitsizlikleri ve erken yaşlanma belirtileri ile uğraşan bireylerde tercih edilir. Hamilelik veya emzirme döneminde olan kadınlar için uygun değildir."
  },
  {
    question: "Sciton BBL Hero lazer tedavisi ağrılı bir işlem midir?",
    answer: "İşlem öncesi lokal anestezik krem uygulanabilir. Lazer ışığı ciltte hafif bir batma veya sıcaklık hissi yaratabilir. Çoğu hasta bu hissi tolere edebilir. Hassas ciltli bireylerde daha fazla rahatsızlık hissedilebilir. Soğutma sistemleri ile konfor artırılabilir."
  },
  {
    question: "Sciton BBL Hero lazer tedavisi etkisi ne zaman görülür?",
    answer: "Ciltteki parlaklık ve eşit ton etkisi genellikle işlem sonrası 1-2 hafta içinde görülmeye başlanır. Ancak maksimum etki 4-6 hafta içinde ortaya çıkar. Cilt yenilenmesi süreci devam ettiği için etki 6-8 hafta boyunca gelişmeye devam eder. Düzenli uygulamalar ile etki daha kalıcı olur."
  },
  {
    question: "Sciton BBL Hero lazer tedavisi kaç seans yapılır?",
    answer: "Optimal sonuçlar için genellikle 3-4 haftada bir olmak üzere 3-5 seans önerilir. Cilt durumuna göre hekim tarafından bireysel planlama yapılır. İlk seans sonrası ciltte belirgin bir iyileşme görülür, ancak seri uygulamalar ile etki daha kalıcı hale gelir."
  },
  {
    question: "Sciton BBL Hero lazer tedavisi hangi cilt sorunlarını tedavi eder?",
    answer: "BBL Hero çok yönlü bir lazer sistemidir ve çeşitli cilt sorunlarını tedavi edebilir: güneş lekeleri, yaş lekeleri, damarlanmalar, gözenek genişlemeleri, ince çizgiler, akne izleri ve genel cilt matlığı. Kişisel ihtiyaçlara göre dalga boyları ayarlanarak özel tedavi planları oluşturulur."
  },
  {
    question: "Sciton BBL Hero lazer tedavisi sonrası güneş koruyucu kullanmalı mıyım?",
    answer: "Evet, lazer tedavisinden sonra güneş koruyucu kullanımı zorunludur. Güneş ışığı lekelerin tekrar oluşmasına neden olabilir. Günlük SPF 30+ koruyucu kullanmak, tedavi sonuçlarının kalıcılığı için çok önemlidir. Özellikle yaz aylarında ekstra dikkat gösterilmelidir."
  },
  {
    question: "Sciton BBL Hero lazer tedavisi diğer işlemlerle birlikte uygulanabilir mi?",
    answer: "Evet, Sciton BBL Hero lazer tedavisi diğer cilt bakım uygulamalarıyla birlikte uygulanabilir. Özellikle mezoterapi, kimyasal peeling ve diğer lazer tedavileriyle kombine edilebilir. Ancak uygulama sırası ve zamanlaması hekim tarafından planlanmalıdır."
  }
];
---

<BaseLayout title={title} description={description}>
  
  <BreadcrumbSchema 
    links={[
      { name: "Ana Sayfa", url: "/" },
      { name: "Dermokozmetik İşlemler", url: "/dermokozmetik/" },
      { name: "Lazer Tedavileri", url: "/dermokozmetik/lazer/" },
      { name: "BBL Hero", url: "/dermokozmetik/lazer/bbl-hero/" }
    ]}
  />

    <FaqSchema questions={faqQuestions} />
    
  <main id="main-content" class="container mx-auto px-4 py-12">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold text-primary mb-8">
        Sciton BBL Hero Lazer Tedavileri
      </h1>
      
      <div class="prose prose-lg text-text-primary max-w-none">
        <p class="mb-8 leading-relaxed">
          Sciton BBL Hero lazer tedavisi, cilt yüzeyindeki çeşitli estetik 
          sorunların giderilmesi amacıyla uygulanan ileri teknoloji 
          BroadBand Light (Geniş Bant Işık) sistemidir. Bu devrimsel 
          lazer teknolojisi, ciltteki lekeleri, damarlanmaları, 
          gözenek genişlemelerini ve ince çizgileri tedavi ederken 
          aynı zamanda cilt yenilenmesini ve sıkılaşmasını sağlar. 
          BBL Hero, farklı dalga boylarında çalışarak kişiselleştirilmiş 
          tedavi planları oluşturur ve ciltte kapsamlı bir gençleşme 
          etkisi sağlar. Bu işlem sayesinde cilt daha parlak, 
          eşit tonlu ve genç bir görünüme kavuşur.
        </p>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          Sciton BBL Hero Lazer Tedavisi Nedir ve Kimler İçin Uygundur?
        </h2>
        
        <p class="mb-6 leading-relaxed">
          Sciton BBL Hero lazer tedavisi, farklı dalga boylarında 
          çalışan BroadBand Light teknolojisinin cilt yüzeyine 
          uygulanmasıyla gerçekleştirilen non-invaziv bir işlemdir. 
          18 yaşını geçmiş, genel sağlık durumu iyi olan ve 
          cildinde yaşlanma belirtileri, lekeler, damarlanmalar 
          veya genel cilt yorgunluğu görülen her yetişkin birey 
          için uygundur. Özellikle güneş hasarı, cilt matlığı, 
          renk eşitsizlikleri ve erken yaşlanma belirtileri 
          ile uğraşan bireylerde tercih edilir. 
          Hamilelik veya emzirme döneminde olan kadınlar 
          için uygun değildir.
        </p>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          Uygulama Süreci Nasıldır?
        </h2>
        
        <p class="mb-6 leading-relaxed">
          Sciton BBL Hero lazer tedavisi işlemi öncesinde cilt 
          temizlenir ve gerekirse yerel anestezik krem uygulanır. 
          Lazer işlemi sırasında hastalar koruyucu gözlük takarlar. 
          Steril koşullarda lazer başlığı cilt yüzeyine uygulanır 
          ve hedeflenen bölgeler tedavi edilir. İşlem 30-60 dakika 
          sürer. Hastalar işlem sonrası hemen günlük yaşamlarına 
          dönebilirler. Ciltte hafif kızarıklık ve şişlik 
          görülebilir ancak bu genellikle 1-2 saat içinde geçer.
        </p>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          İşlem Sonrası Dikkat Edilmesi Gerekenler
        </h2>
        
        <p class="mb-6 leading-relaxed">
          Sciton BBL Hero lazer tedavisi sonrası ilk 48 saat 
          içinde uygulama bölgesine masaj uygulanmamalı ve 
          makyaj yapılmamalıdır. İlk 1 hafta boyunca yüzü 
          yıkarken ılık su kullanılmalı, sıcak su ve havlu 
          ile ovuşturma yapılmalıdır. Güneş koruyucu 
          kullanmak çok önemlidir. İlk günlerde uygulama 
          bölgesinde hafif kızarıklık ve şişlik normaldir. 
          Bu belirtiler genellikle 3-7 gün içinde geçer.
        </p>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          Sıkça Sorulan Sorular
        </h2>
        
        <div class="space-y-6 mb-12">
          <div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">
              Sciton BBL Hero lazer tedavisi ağrılı bir işlem midir?
            </h3>
            <p class="leading-relaxed">
              İşlem öncesi lokal anestezik krem uygulanabilir. 
              Lazer ışığı ciltte hafif bir batma veya sıcaklık 
              hissi yaratabilir. Çoğu hasta bu hissi tolere 
              edebilir. Hassas ciltli bireylerde daha fazla 
              rahatsızlık hissedilebilir. Soğutma sistemleri 
              ile konfor artırılabilir.
            </p>
          </div>
          
          <div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">
              Sciton BBL Hero lazer tedavisi etkisi ne zaman görülür?
            </h3>
            <p class="leading-relaxed">
              Ciltteki parlaklık ve eşit ton etkisi genellikle 
              işlem sonrası 1-2 hafta içinde görülmeye başlanır. 
              Ancak maksimum etki 4-6 hafta içinde ortaya çıkar. 
              Cilt yenilenmesi süreci devam ettiği için etki 
              6-8 hafta boyunca gelişmeye devam eder. 
              Düzenli uygulamalar ile etki daha kalıcı olur.
            </p>
          </div>
          
          <div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">
              Sciton BBL Hero lazer tedavisi kaç seans yapılır?
            </h3>
            <p class="leading-relaxed">
              Optimal sonuçlar için genellikle 3-4 haftada 
              bir olmak üzere 3-5 seans önerilir. Cilt 
              durumuna göre hekim tarafından bireysel 
              planlama yapılır. İlk seans sonrası ciltte 
              belirgin bir iyileşme görülür, ancak 
              seri uygulamalar ile etki daha kalıcı hale gelir.
            </p>
          </div>
          
          <div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">
              Sciton BBL Hero lazer tedavisi hangi cilt sorunlarını tedavi eder?
            </h3>
            <p class="leading-relaxed">
              BBL Hero çok yönlü bir lazer sistemidir ve 
              çeşitli cilt sorunlarını tedavi edebilir: 
              güneş lekeleri, yaş lekeleri, damarlanmalar, 
              gözenek genişlemeleri, ince çizgiler, 
              akne izleri ve genel cilt matlığı. 
              Kişisel ihtiyaçlara göre dalga boyları 
              ayarlanarak özel tedavi planları oluşturulur.
            </p>
          </div>
        </div>
      </div>
      
      <!-- Randevu Butonu -->
      <div class="text-center mt-12">
        <a 
          href="/iletisim" 
          class="inline-block bg-accent hover:bg-orange-600 text-white font-semibold py-4 px-8 rounded-lg transition-colors duration-300 transform hover:scale-105 shadow-lg"
        >
          📅 Randevu Al
        </a>
        <p class="mt-4 text-text-secondary">
          Uzman dermatolog gözetiminde BBL Hero lazer tedavisi için randevu alın.
        </p>
      </div>
    </div>
  </main>

</BaseLayout>