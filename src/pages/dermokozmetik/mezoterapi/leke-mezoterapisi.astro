---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../../components/BreadcrumbSchema.astro';
import FaqSchema from '../../../components/FaqSchema.astro';

const title = "Leke Mezoterapisi - Uzm. Dr. Umut Mert Yıldırım";
const description = "Cilt lekelerinin giderilmesi için uygulanan leke mezoterapisi işlemi hakkında detaylı bilgi, uygulama süreci ve sıkça sorulan sorular.";

// SSS için soru-cevaplar
const faqQuestions = [
  {
    question: "Leke mezoterapisi nedir ve nasıl çalışır?",
    answer: "Leke mezoterapisi, cilt yüzeyindeki kahverengi lekelerinin giderilmesi amacıyla uygulanan özel formüllü mezoterapi uygulamasıdır. Güneş lekeleri, yaşlanma lekeleri, melazma ve diğer pigmentasyon bozuklukları için etkili bir tedavi seçeneğidir. Vitamin C, glutatyon, koenzim Q10 ve diğer leke açıcı ajanların cilt yüzeyine mikro enjeksiyonlarla uygulanmasıyla leke görünümü açılır ve cilt daha eşit bir ton kazanır. Bu işlem sayesinde ciltteki estetik sorunlar giderilir ve daha homojen bir görünüm elde edilir."
  },
  {
    question: "Leke mezoterapisi kimler için uygundur?",
    answer: "Leke mezoterapisi, kahverengi pigment üreten hücreleri etkileyen özel aktif maddelerin cilt yüzeyine mikro enjeksiyonlarla uygulanan minimal invaziv bir işlemdir. 18 yaşını tamamlamış, genel sağlık durumu iyi olan ve cilt lekeleri şikayeti olan her yetişkin birey için uygundur. Özellikle güneş lekeleri, yaşlanma lekeleri, melazma ve post-inflamatuar hiperpigmentasyon ile uğraşan bireylerde tercih edilir. Hamilelik veya emzirme döneminde olan kadınlar için uygun değildir."
  },
  {
    question: "Leke mezoterapisi ağrılı bir işlem midir?",
    answer: "İşlem öncesi lokal anestezik krem uygulanabilir. İğneler çok ince olduğu için hastalar genellikle hafif bir battı hissi yaşarlar. İşlem kısa sürede tamamlandığı için genellikle kolayca tolere edilir. Hassas ciltli bireylerde daha fazla rahatsızlık hissedilebilir."
  },
  {
    question: "Leke mezoterapisi etkisi ne zaman görülür?",
    answer: "Lekede azalma genellikle 2-3 hafta sonra görülmeye başlanır. Ancak maksimum etki 6-8 hafta içinde ortaya çıkar. Lekelerin tipine ve derinliğine bağlı olarak sonuçlar değişebilir. Düzenli uygulamalar ile leke görünümü büyük oranda azaltılabilir."
  },
  {
    question: "Leke mezoterapisi kaç seans yapılır?",
    answer: "Optimal sonuçlar için genellikle 2-3 haftada bir olmak üzere 4-6 seans önerilir. Lekelerin tipine ve derinliğine göre hekim tarafından bireysel planlama yapılır. Melazma gibi dirençli lekelerde daha fazla seans gerekebilir."
  },
  {
    question: "Leke mezoterapisi sonrası güneş koruyucu kullanmalı mıyım?",
    answer: "Evet, leke tedavisinden sonra güneş koruyucu kullanımı zorunludur. Güneş ışığı lekelerin tekrar oluşmasına neden olabilir. Günlük SPF 30+ koruyucu kullanmak, tedavi sonuçlarının kalıcılığı için çok önemlidir. Özellikle yaz aylarında ekstra dikkat gösterilmelidir."
  },
  {
    question: "Leke mezoterapisi diğer işlemlerle birlikte uygulanabilir mi?",
    answer: "Evet, leke mezoterapisi diğer cilt bakım uygulamalarıyla birlikte uygulanabilir. Özellikle lazer tedavileri, kimyasal peeling ve diğer mezoterapi uygulamalarıyla kombine edilebilir. Ancak uygulama sırası ve zamanlaması hekim tarafından planlanmalıdır."
  },
  {
    question: "Leke mezoterapisi tedavisi ne kadar sürer?",
    answer: "Leke mezoterapisi işlemi genellikle 30-45 dakika sürer. Uygulama alanına göre işlem süresi değişebilir. Hastalar işlem sonrası hemen günlük yaşamlarına dönebilirler. Ancak işlem yapılan bölgede hafif kızarıklık ve şişlik görülebilir, bu belirtiler genellikle 1-2 saat içinde geçer."
  }
];
---

<BaseLayout title={title} description={description}>
  
    <BreadcrumbSchema 
    links={[
      { name: "Ana Sayfa", url: "/" },
      { name: "Dermokozmetik İşlemler", url: "/dermokozmetik/" },
      { name: "Mezoterapi", url: "/dermokozmetik/mezoterapi/" },
      { name: "Leke Mezoterapisi", url: "/dermokozmetik/lazer/leke-mezoterapisi/" }
    ]}
  />

   <FaqSchema questions={faqQuestions} />

  <main id="main-content" class="container mx-auto px-4 py-12">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold text-primary mb-8">
        Leke Mezoterapisi
      </h1>
      
      <div class="prose prose-lg text-text-primary max-w-none">
        <p class="mb-8 leading-relaxed">
          Leke mezoterapisi, cilt yüzeyindeki kahverengi lekelerinin giderilmesi 
          amacıyla uygulanan özel formüllü mezoterapi uygulamasıdır. Güneş lekeleri, 
          yaşlanma lekeleri, melazma ve diğer pigmentasyon bozuklukları için etkili bir 
          tedavi seçeneğidir. Vitamin C, glutatyon, koenzim Q10 ve diğer leke açıcı 
          ajanların cilt yüzeyine mikro enjeksiyonlarla uygulanmasıyla leke görünümü açılır
          ve cilt daha eşit bir ton kazanır.
        </p>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          Leke Mezoterapisi Nedir ve Kimler İçin Uygundur?
        </h2>
        
        <p class="mb-6 leading-relaxed">
          Leke mezoterapisi, kahverengi pigment üreten hücreleri etkileyen özel aktif maddelerin 
          cilt yüzeyine mikro enjeksiyonlarla uygulanan minimal invaziv bir işlemdir. 
          18 yaşını tamamlamış, genel sağlık durumu iyi olan ve cilt lekeleri 
          şikayeti olan her yetişkin birey için uygundur. Özellikle güneş lekeleri, 
          yaşlanma lekeleri, melazma ve post-inflamatuar hiperpigmentasyon ile 
          uğraşan bireylerde tercih edilir. Hamilelik veya emzirme döneminde 
          olan kadınlar için uygun değildir.
        </p>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          Uygulama Süreci Nasıldır?
        </h2>
        
        <p class="mb-6 leading-relaxed">
          Leke mezoterapisi işlemi öncesinde cilt temizlenir ve lokal 
          anestezik krem uygulanır. Steril koşullarda ve çok ince iğnelerle 
          özel formüllü leke tedavi maddesi cilt yüzeyine 
          enjekte edilir. İşlem 30-45 dakika sürer. Hastalar işlem 
          sonrası hemen günlük yaşamlarına dönebilirler. Ciltte hafif 
          kızarıklık görülebilir ancak bu genellikle 1-2 saat içinde geçer.
        </p>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          İşlem Sonrası Dikkat Edilmesi Gerekenler
        </h2>
        
        <p class="mb-6 leading-relaxed">
          Leke mezoterapisi sonrası ilk 24 saat içinde uygulama bölgesine 
          masaj uygulanmamalı ve makyaj yapılmamalıdır. İlk 3 gün boyunca 
          yüzü yıkarken ılık su kullanılmalı, sıcak su ve havlu ile 
          ovuşturma yapılmalıdır. Güneş koruyucu kullanmak çok önemlidir. 
          İlk günlerde uygulama bölgesinde hafif kızarıklık ve hassasiyet 
          normaldir. Bu belirtiler genellikle birkaç saat içinde geçer.
        </p>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          Sıkça Sorulan Sorular
        </h2>
        
        <div class="space-y-6 mb-12">
          <div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">
              Leke mezoterapisi ağrılı bir işlem midir?
            </h3>
            <p class="leading-relaxed">
              İşlem öncesi lokal anestezik krem uygulanabilir. İğneler çok 
              ince olduğu için hastalar genellikle hafif bir batma hissi 
              yaşarlar. İşlem kısa sürede tamamlandığı için genellikle 
              kolayca tolere edilir. Hassas ciltli bireylerde daha fazla 
              rahatsızlık hissedilebilir.
            </p>
          </div>
          
          <div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">
              Leke mezoterapisi etkisi ne zaman görülür?
            </h3>
            <p class="leading-relaxed">
              Lekede azalma genellikle 2-3 hafta sonra görülmeye 
              başlanır. Ancak maksimum etki 6-8 hafta içinde ortaya çıkar. 
              Lekelerin tipine ve derinliğine bağlı olarak sonuçlar değişebilir. 
              Düzenli uygulamalar ile leke görünümü büyük oranda azaltılabilir.
            </p>
          </div>
          
          <div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">
              Leke mezoterapisi kaç seans yapılır?
            </h3>
            <p class="leading-relaxed">
              Optimal sonuçlar için genellikle 2-3 haftada bir olmak üzere 
              4-6 seans önerilir. Lekelerin tipine ve derinliğine göre 
              hekim tarafından bireysel planlama yapılır. Melazma gibi 
              dirençli lekelerde daha fazla seans gerekebilir.
            </p>
          </div>
          
          <div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">
              Leke mezoterapisi sonrası güneş koruyucu kullanmalı mıyım?
            </h3>
            <p class="leading-relaxed">
              Evet, leke tedavisinden sonra güneş koruyucu kullanımı 
              zorunludur. Güneş ışığı lekelerin tekrar oluşmasına neden 
              olabilir. Günlük SPF 30+ koruyucu kullanmak, tedavi 
              sonuçlarının kalıcılığı için çok önemlidir. Özellikle 
              yaz aylarında ekstra dikkat gösterilmelidir.
            </p>
          </div>
        </div>
      </div>
      
      <!-- Randevu Butonu -->
      <div class="text-center mt-12">
        <a 
          href="/iletisim" 
          class="inline-block bg-accent hover:bg-orange-600 text-white font-semibold py-4 px-8 rounded-lg transition-colors duration-300 transform hover:scale-105 shadow-lg"
        >
          📅 Randevu Al
        </a>
        <p class="mt-4 text-text-secondary">
          Uzman dermatolog gözetiminde leke mezoterapisi işlemi için randevu alın.
        </p>
      </div>
    </div>
  </main>
  
</BaseLayout>