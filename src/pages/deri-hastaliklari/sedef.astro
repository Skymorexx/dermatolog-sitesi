---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro';
import FaqSchema from '../../components/FaqSchema.astro';

const title = "Sedef Hastalığı (Psöriyazis) Tedavisi - Uzm. Dr. Umut Mert Yıldırım";
const description = "Sedef hastalığı (psöriyazis) hakkında bilgi, klinik belirtileri ve kliniğimizde uygulanan güncel tedavi seçenekleri.";

// SSS için soru-cevaplar
const faqQuestions = [
{
question: "Sedef hastalığı (psöriyazis) nedir ve nasıl oluşur?",
answer: "Sedef hastalığı, cilt hücrelerinin normalden çok daha hızlı yenilenmesi sonucu ortaya çıkan kronik iltihabi bir deri hastalığıdır. Genellikle kırmızı, pullu plaklar şeklinde kendini gösterir ve şiddetine göre hastaların yaşam kalitesini önemli ölçüde etkileyebilir. Hastalık, genetik yatkınlık ve çevresel faktörlerin etkileşimi sonucu gelişir. Sedef hastalığı, bağışıklık sistemindeki bozukluk nedeniyle cilt hücrelerinin normal döngüsünden çok daha hızlı yenilenmesiyle karakterize edilir. Normalde cilt hücreleri 28-30 günde yenilenirken, sedef hastalığında bu süreç 3-4 güne iner. Bu hızlı hücre yenilenmesi, ciltte kalın, pullu ve kızarıklıklarla sonuçlanır. En sık görülen tipi plak tipi sedef hastalığıdır."
},
{
question: "Sedef hastalığı (psöriyazis) tedavisi kimler için uygundur?",
answer: "Sedef hastalığı, bağışıklık sistemindeki bozukluk nedeniyle cilt hücrelerinin normal döngüsünden çok daha hızlı yenilenmesiyle karakterize edilen kronik iltihabi bir deri hastalığıdır. Genellikle kırmızı, pullu plaklar şeklinde kendini gösterir ve şiddetine göre hastaların yaşam kalitesini önemli ölçüde etkileyebilir. Özellikle plak tipi sedef hastalığı, guttat psöriyazis, invers psöriyazis, püstüler psöriyazis ve eritrodermik psöriyazis gibi tanıları olan bireylerde tercih edilir."
},
{
question: "Sedef hastalığı (psöriyazis) tedavisi ağrılı bir işlem midir?",
answer: "Sedef hastalığı tedavisi genellikle ağrılı bir işlem değildir. Tedavi seçenekleri topikal tedaviler, fototerapi ve sistemik ilaç tedavileri olmak üzere üç ana grupta toplanır. Hafif olgularda topikal tedaviler yeterli olabilirken, orta-ağır olgularda biyolojik ilaçlar ve diğer sistemik tedaviler gerekebilir."
},
{
question: "Sedef hastalığı (psöriyazis) tedavisi etkisi ne zaman görülür?",
answer: "Sedef hastalığı tedavisi etkisi genellikle 4-8 hafta sonra görülmeye başlanır. Ancak maksimum etki 2-3 ay içinde ortaya çıkar. Tedavi süresi hastalığın şiddeti, yaygınlığı ve bireysel yanıta göre değişir. İlk iyileşme genellikle 4-8 hafta içinde görülür, ancak uzun vadeli bakım ve takip gereklidir. Biyolojik tedavilerde etki genellikle 2-3 ay içinde maksimum düzeye ulaşır."
},
{
question: "Sedef hastalığı (psöriyazis) tedavisi kaç seans yapılır?",
answer: " Tedavi süresi hastalığın şiddeti, yaygınlığı ve bireysel yanıta göre değişir. Hafif olgularda topikal tedaviler yeterli olabilirken, orta-ağır olgularda biyolojik ilaçlar ve diğer sistemik tedaviler gerekebilir."
},
{
question: "Sedef hastalığı (psöriyazis) tamamen iyileşir mi?",
answer: "Sedef hastalığının günümüzde kalıcı iyileşme sağlayan bir tedavisi olmamakla birlikte, modern tedavi yöntemleri ile semptomlar büyük ölçüde kontrol altına alınabilir ve hastalar normal yaşam kalitesine kavuşabilirler. Bazı hastalarda uzun süreli remisyonlar da mümkündür. Tedavi seçenekleri topikal tedaviler, fototerapi ve sistemik ilaç tedavileri olmak üzere üç ana grupta toplanır. Hafif olgularda topikal tedaviler yeterli olabilirken, orta-ağır olgularda biyolojik ilaçlar ve diğer sistemik tedaviler gerekebilir. Etki kaybolduğunda tekrar uygulama yapılabilir."
},
{
question: "Sedef hastalığı (psöriyazis) diğer işlemlerle birlikte uygulanabilir mi?",
answer: "Evet, sedef hastalığı tedavisi diğer cilt bakım uygulamalarıyla birlikte uygulanabilir. Özellikle lazer tedavileri, mezoterapi ve diğer non-invaziv prosedürlerle kombine edilebilir. Ancak uygulama sırası ve zamanlaması hekim tarafından planlanmalıdır."
}
];
---

<BaseLayout title={title} description={description}>

      <BreadcrumbSchema 
    links={[
      { name: "Ana Sayfa", url: "/" },
      { name: "Deri Hastalıkları", url: "/deri-hastaliklari/" },
      { name: "Sedef Hastalığı (Psöriyazis) Tedavisi", url: "/deri-hastaliklari/sedef/" },
    ]}
  />
  
  <FaqSchema questions={faqQuestions} />

  <main id="main-content" class="container mx-auto px-4 py-12">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold text-primary mb-8">
        Sedef Hastalığı (Psöriyazis) ve Tedavi Yöntemleri
      </h1>
      
      <div class="prose prose-lg text-text-primary max-w-none">
        <p class="mb-8 leading-relaxed">
          Sedef hastalığı, cilt hücrelerinin normalden çok daha hızlı yenilenmesi sonucu ortaya çıkan 
          kronik iltihabi bir deri hastalığıdır. Genellikle kırmızı, pullu plaklar şeklinde kendini gösterir 
          ve şiddetine göre hastaların yaşam kalitesini önemli ölçüde etkileyebilir. Hastalık, genetik yatkınlık ve 
          çevresel faktörlerin etkileşimi sonucu gelişir.
        </p>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          Sedef Hastalığı Nedir?
        </h2>
        
        <p class="mb-6 leading-relaxed">
          Sedef hastalığı, bağışıklık sistemindeki bozukluk nedeniyle cilt hücrelerinin normal döngüsünden 
          çok daha hızlı yenilenmesiyle karakterize edilir. Normalde cilt hücreleri 28-30 günde yenilenirken, 
          sedef hastalığında bu süreç 3-4 güne iner. Bu hızlı hücre yenilenmesi, ciltte kalın, pullu ve 
          kızarıklıklarla sonuçlanır. En sık görülen tipi plak tipi sedef hastalığıdır.
        </p>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          Tedavi Seçenekleri Nelerdir?
        </h2>
        
        <p class="mb-6 leading-relaxed">
          Sedef hastalığı tedavisi, hastalığın şiddeti, yaygınlığı ve hastanın yaşam kalitesini etkileme 
          düzeyine göre kişiselleştirilir. Tedavi seçenekleri topikal tedaviler, fototerapi ve sistemik 
          ilaç tedavileri olmak üzere üç ana grupta toplanır. Hafif olgularda topikal tedaviler yeterli 
          olabilirken, orta-ağır olgularda biyolojik ilaçlar ve diğer sistemik tedaviler gerekebilir.
        </p>
        
        <ul class="list-disc list-inside mb-8 space-y-2">
          <li>Topikal kortikosteroidler ve vitamin D analogları</li>
          <li>Fototerapi (UVB Narrowband, PUVA)</li>
          <li>Sistemik immün suppressif ilaçlar</li>
          <li>Biyolojik tedaviler (Anti-TNF, IL-12/23, IL-17 inhibitörleri)</li>
          <li>JAK inhibitörleri (yeni nesil oral ilaçlar)</li>
          <li>Kombinasyon tedavileri</li>
        </ul>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          Sıkça Sorulan Sorular
        </h2>
        
        <div class="space-y-6 mb-12">
          <div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">
              Sedef hastalığı bulaşıcı mıdır?
            </h3>
            <p class="leading-relaxed">
              Hayır, sedef hastalığı kesinlikle bulaşıcı değildir. Genetik yatkınlık ve bağışıklık sistemi 
              bozuklukları nedeniyle gelişir. Başka kişilere temas yoluyla geçmez.
            </p>
          </div>
          
          <div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">
              Sedef hastalığı tamamen iyileşir mi?
            </h3>
            <p class="leading-relaxed">
              Sedef hastalığı şu anda tamamen iyileştiren bir tedavisi olmamakla birlikte, modern tedavi 
              yöntemleri ile semptomlar büyük ölçüde kontrol altına alınabilir ve hastalar normal yaşam 
              kalitesine kavuşabilirler. Bazı hastalarda uzun süreli remisyonlar da mümkündür.
            </p>
          </div>
          
          <div>
            <h3 class="text-xl font-semibold text-text-primary mb-2">
              Sedef hastalığı tedavisi ne kadar sürer?
            </h3>
            <p class="leading-relaxed">
              Tedavi süresi hastalığın şiddeti ve bireysel yanıta göre değişir. İlk iyileşme genellikle 
              4-8 hafta içinde görülür, ancak uzun vadeli bakım ve takip gereklidir. Biyolojik tedavilerde 
              etki genellikle 2-3 ay içinde maksimum düzeye ulaşır.
            </p>
          </div>
        </div>
      </div>
      <!-- Etik ve Yasal Uyarı -->
      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 my-12">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-yellow-700">
              <strong>Önemli Uyarı:</strong> Bu sayfadaki bilgiler yalnızca bilgilendirme amaçlıdır ve tıbbi tavsiye yerine geçmez. Cildinizde şüpheli bir değişiklik fark ederseniz derhal bir dermatoloji uzmanına başvurunuz.
            </p>
          </div>
        </div>
      </div>
      <!-- Randevu Butonu -->
      <div class="text-center mt-12">
        <a 
          href="/iletisim" 
          class="inline-block bg-accent hover:bg-orange-600 text-white font-semibold py-4 px-8 rounded-lg transition-colors duration-300 transform hover:scale-105 shadow-lg"
        >
          📅 Randevu Al
        </a>
        <p class="mt-4 text-text-secondary">
          Uzman dermatolog gözetiminde sedef hastalığı tedavisi için randevu alın.
        </p>
      </div>
    </div>
  </main>
  
</BaseLayout>