---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import FaqSchema from '../components/FaqSchema.astro';

const title = "Teledermatoloji (Online Muayene) - Uzm. Dr. Umut Mert Yıldırım";
const description = "Konforunuzdan ayrılmadan, online görüntülü görüşme ile cilt hastalıklarınız için uzman muayene hizmeti alın. Teledermatoloji süreci ve uygun durumlar hakkında bilgi.";

// SSS için soru-cevaplar
const faqQuestions = [
  {
    question: "Teledermatoloji nedir?",
    answer: "Teledermatoloji, internet üzerinden yapılan görüntülü görüşme yoluyla dermatolojik danışmanlık ve değerlendirme hizmetidir. Hastalar, ev ortamında konforlu bir şekilde uzman hekimle görüşebilir, cilt problemlerini gösterebilir ve profesyonel öneriler alabilir. Bu hizmet, özellikle kontrol muayeneleri, danışmanlık ve reçete yenileme gibi durumlarda çok etkilidir."
  },
  {
    question: "Teledermatoloji ile fiziksel muayene arasında fark var mı?",
    answer: "Evet, teledermatoloji fiziksel muayenenin yerine geçmez. Fiziksel muayenede dokunsal değerlendirme ve dermatoskopik inceleme gibi detaylı tetkikler yapılabilir. Ancak teledermatoloji, kontrol muayeneleri, tedavi sürecinde danışmanlık ve reçete yenileme gibi durumlar için oldukça uygundur. Hekim, gerekli gördüğü durumlarda yüz yüze muayene talep edebilir."
  },
  {
    question: "Teledermatoloji hangi durumlar için uygundur?",
    answer: "Teledermatoloji özellikle kontrol muayeneleri, tedavi sürecinde danışmanlık ve reçete yenileme, cilt bakım önerileri, rutin kontroller, estetik dermatoloji danışmanlıkları, deri hastalıklarının seyrinde değerlendirme ve coğrafi veya fiziksel erişim sorunları olan hastalar için uygundur. Ancak acil durumlar ve ileri derecede fiziksel muayene gerektiren vakalar için uygun değildir."
  },
  {
    question: "Teledermatoloji randevusu nasıl alınır?",
    answer: "Teledermatoloji randevusu web sitemizden veya telefonla alınabilir. Size uygun bir tarih ve saat belirlenir. Randevu bilgileriniz size e-posta veya SMS ile iletilir. Görüşme öncesi cilt probleminizin net fotoğraflarını hazırlamanız önerilir."
  },
  {
    question: "Teledermatoloji görüşmesi sırasında ne yapmalıyım?",
    answer: "Görüşme öncesi cilt probleminizin net fotoğraflarını hazırlayın. Görüşme sırasında iyi aydınlatılmış bir ortamda olun. Probleminizi detaylı şekilde anlatın ve hekimin sorularına açık cevaplar verin. Gerekli görülmesi halinde reçete düzenlenir ve size e-reçete olarak iletilir."
  },
  {
    question: "Teledermatoloji güvenli midir?",
    answer: "Evet, teledermatoloji güvenli bir hizmettir. Hastaların kişisel verileri KVKK ve diğer gizlilik politikalarına uygun olarak korunur. Görüşmeler şifreli bağlantılar üzerinden gerçekleştirilir. Ancak bu hizmet fiziksel muayenenin yerine geçmez ve acil durumlar için uygun değildir."
  }
];
---

<BaseLayout title={title} description={description}>

  <BreadcrumbSchema 
    links={[
      { name: "Ana Sayfa", url: "/" },
      { name: "Online Muayene", url: "/teledermatoloji/" },
    ]}
  />
    <FaqSchema questions={faqQuestions} />

  <main id="main-content" class="container mx-auto px-4 py-16">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold text-primary mb-8">
        Online Muayene (Teledermatoloji)
      </h1>
      
      <div class="prose prose-lg text-text-primary max-w-none">
        <p class="mb-8 leading-relaxed">
          Teledermatoloji, modern teknolojiyi kullanarak 
          yüz yüze gitmeden uzman dermatoloğun 
          görüşüne ulaşmanızı sağlayan 
          yenilikçi bir sağlık hizmetidir. 
          Görüntülü görüşme yoluyla 
          cilt problemlerinizin 
          değerlendirilmesi, 
          tedavi önerilerinin 
          sunulması ve 
          reçete düzenlenmesi 
          mümkündür. Bu 
          hizmet sayesinde 
          zaman ve mekan 
          kısıtlılığı olmadan 
          profesyonel 
          dermatolojik 
          destek 
          alabilirsiniz.
        </p>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          Teledermatoloji (Uzaktan Görüntülü Muayene) Nedir?
        </h2>
        
        <p class="mb-6 leading-relaxed">
          Teledermatoloji, internet üzerinden 
          yapılan görüntülü görüşme yoluyla 
          dermatolojik danışmanlık ve 
          değerlendirme hizmetidir. 
          Hastalar, ev ortamında 
          konforlu bir şekilde 
          uzman hekimle 
          görüşebilir, cilt 
          problemlerini 
          gösterebilir ve 
          profesyonel 
          öneriler 
          alabilir. 
          Bu hizmet, 
          özellikle 
          kontrol 
          muayeneleri, 
          danışmanlık 
          ve reçete 
          yenileme 
          gibi 
          durumlarda 
          çok 
          etkilidir.
        </p>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          Kimler İçin Uygundur?
        </h2>
        
        <div class="mb-6">
          <p class="leading-relaxed mb-4">
            Teledermatoloji, belirli durumlar 
            için oldukça uygundur. Ancak 
            tüm dermatolojik 
            sorunlar için uygun 
            değildir. Aşağıdaki 
            durumlar için 
            teledermatoloji 
            tercih edilebilir:
          </p>
          
          <ul class="list-disc list-inside space-y-2">
            <li>Kontrol muayeneleri ve takip görüşmeleri</li>
            <li>Tedavi sürecinde danışmanlık ve reçete yenileme</li>
            <li>Cilt bakım önerileri ve rutin kontroller</li>
            <li>Estetik dermatoloji danışmanlıkları</li>
            <li>Deri hastalıklarının seyrinde değerlendirme</li>
            <li>Hastalara bilgilendirme ve rehberlik</li>
            <li>Acil olmayan dermatolojik sorunların değerlendirilmesi</li>
            <li>Coğrafi veya fiziksel erişim sorunları olan hastalar için</li>
          </ul>
        </div>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          Süreç Nasıl İşliyor?
        </h2>
        
        <div class="mb-6">
          <p class="leading-relaxed mb-4">
            Teledermatoloji süreci, kolay 
            ve pratik adımlardan 
            oluşur. Aşağıdaki 
            adımları takip 
            ederek online 
            görüşmenizi 
            gerçekleştirebilirsiniz:
          </p>
          
          <ol class="list-decimal list-inside space-y-4">
            <li>
              <strong>Randevu Alın:</strong> 
              Web sitemizden veya telefonla 
              randevu alabilirsiniz. 
              Size uygun bir 
              tarih ve saat 
              belirlenir. Randevu 
              bilgileriniz size 
              e-posta veya SMS 
              ile iletilir.
            </li>
            
            <li>
              <strong>Görüşmeyi Yapın:</strong> 
              Belirlenen tarihte ve saatte 
              uygulama üzerinden 
              görüşmeye katılırsınız. 
              Görüşme öncesi cilt 
              probleminizin net 
              fotoğraflarını 
              hazırlamanız 
              önerilir. 
              Görüşme 
              sırasında 
              hekimle 
              yüz yüze 
              iletişim 
              kurarsınız.
            </li>
            
            <li>
              <strong>Tedavi Planınızı Alın:</strong> 
              Hekim değerlendirmesinden 
              sonra size uygun 
              tedavi önerileri 
              sunulur. Gerekli 
              görülmesi halinde 
              reçete düzenlenir 
              ve size e-reçete 
              olarak iletilir. 
              Takip görüşmeleri 
              için yeni 
              randevular 
              planlanabilir.
            </li>
          </ol>
        </div>
        
        <h2 class="text-2xl font-bold text-primary mt-12 mb-6">
          Önemli Bilgilendirme
        </h2>
        
        <div class="mb-6">
          <p class="leading-relaxed mb-4">
            Teledermatoloji, fiziksel 
            muayenenin yerine 
            geçmez. Bu hizmet, 
            sadece belirli 
            durumlar için 
            uygundur ve 
            bazı sınırlamaları 
            vardır. Acil 
            dermatolojik 
            durumlar için 
            yüz yüze 
            muayene 
            gereklidir. 
            Teşhis 
            ve tedavi 
            sürecinde 
            hekimin 
            klinik 
            değerlendirme 
            yapması 
            gerekebilir.  
            Hekim, 
            gerekli 
            gördüğü 
            durumlarda 
            yüz 
            yüze 
            muayene 
            talep 
            edebilir.
          </p>
          
          <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 my-6">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <p class="text-sm text-yellow-700">
                  <strong>Uyarı:</strong> Teledermatoloji acil durumlar için uygun değildir. 
                  Ciddi cilt reaksiyonları, hızlı büyüyen lezyonlar, kanama, ağrı veya 
                  diğer acil durumlar için lütfen en yakın acil servise başvurunuz.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Randevu Butonu -->
      <div class="text-center mt-12">
        <a 
          href="/iletisim" 
          class="inline-block bg-accent hover:bg-orange-600 text-white font-semibold py-4 px-8 rounded-lg transition-colors duration-300 transform hover:scale-105 shadow-lg"
        >
          📅 Görüntülü Muayene Randevusu Alın
        </a>
        <p class="mt-4 text-text-secondary">
          Uzman dermatolog gözetiminde teledermatoloji (online muayene) hizmeti için randevu alın.
        </p>
      </div>
    </div>
  </main>
  
</BaseLayout>